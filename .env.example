AUTH_PATH=https://api.example.com/auth
DSPEAK_HTTP_PORT=31100
DSPEAK_PUBLIC_ORIGIN=https://app.example.com
DSPEAK_TRUST_PROXY=true
DSPEAK_METRICS_TOKEN=replace-with-a-long-random-secret
DSPEAK_CSRF_SECRET=replace-with-at-least-32-random-characters
DSPEAK_PUSH_ALLOWED_HOSTS=

POCKETBASE_URL=https://pocketbase.example.com
PBASE_ADMIN_EMAIL=admin@example.com
PBASE_ADMIN_PASSWORD=change-me

VAPID_PUBLIC_KEY=
VAPID_PUBKEY=
VAPID_PRIVKEY=
VAPID_SUBJECT=mailto:admin@example.com

MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=auto
MEDIASOUP_ANNOUNCED_ADDRESS_URL=https://api6.ipify.org
MEDIASOUP_RTC_PORT=40000
MEDIASOUP_ANNOUNCED_PORT=40000
MEDIASOUP_DIRECT_ADDRESS=rtc.dspeak.example.com
MEDIASOUP_DIRECT_PORT=40000
MEDIASOUP_MAX_CLIENT_OUTGOING_BITRATE=4500000
MEDIASOUP_MAX_SERVER_OUTGOING_BITRATE=40000000

# Create a Docker agent at https://playit.gg/account/agents/new-docker.
PLAYIT_SECRET_KEY=

# Scoped Cloudflare token used to update the direct DNS-only AAAA records.
DSPEAK_CLOUDFLARE_API_TOKEN=
DSPEAK_RTC_DOMAIN=rtc.dspeak.example.com
DSPEAK_LIVE_DOMAIN=live.dspeak.example.com
DSPEAK_DDNS_IP6_PROVIDER=local.iface:ens3

# SRT application ingest. Playit maps its public UDP endpoint to this local port.
DSPEAK_INGEST_LISTEN_PORT=9999
DSPEAK_INGEST_FALLBACK_DOMAIN=live4.dspeak.example.com
DSPEAK_INGEST_FALLBACK_PORT=5627

TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=900
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=1200
TURN_MAX_BPS=25000000
TURN_CERT_EMAIL=
TURN_CLOUDFLARE_API_TOKEN=
TURN_CERT_DNS_PROPAGATION_SECONDS=30

# Optional external overrides. Leave blank for the monolithic same-origin setup.
