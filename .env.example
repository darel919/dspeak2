DSPEAK_HTTP_PORT=31100
DSPEAK_PUBLIC_ORIGIN=https://app.example.com
DSPEAK_TRUST_PROXY=true
DSPEAK_METRICS_TOKEN=replace-with-a-long-random-secret
DSPEAK_CSRF_SECRET=replace-with-at-least-32-random-characters
DSPEAK_CRON_SECRET=replace-with-a-long-random-secret
DSPEAK_PUSH_ALLOWED_HOSTS=

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
DATABASE_URL=postgresql://postgres:***@db.example.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:***@db.example.com:5432/postgres

VAPID_PUBLIC_KEY=
VAPID_PUBKEY=
VAPID_PRIVKEY=
VAPID_SUBJECT=mailto:admin@example.com


# Scoped Cloudflare token used to update the direct DNS-only AAAA records.
DSPEAK_CLOUDFLARE_API_TOKEN=
DSPEAK_RTC_DOMAIN=rtc.dspeak.example.com
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_CREDENTIAL_TTL_SECONDS=86400
DSPEAK_DDNS_IP6_PROVIDER=local.iface:ens3

TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=900
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=1200
TURN_MAX_BPS=25000000
TURN_CERT_EMAIL=
TURN_CLOUDFLARE_API_TOKEN=
TURN_CERT_DNS_PROPAGATION_SECONDS=30

MEDIA_CONTROL_URL=https://media-control.your-domain.workers.dev
MEDIA_CONTROL_ISSUER=dspeak-media-control
MEDIA_CONTROL_ADMIN_TOKEN=replace-with-a-long-random-secret
# Ed25519 private key (PKCS8 PEM base64) for signing media tickets.
# Generate: openssl genpkey -algorithm Ed25519 -out media-ticket-private.pem && base64 -i media-ticket-private.pem
MEDIA_TICKET_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dspeak
DSPEAK_SFU_HTTP_URL=https://sfu.example.com
DSPEAK_SFU_METRICS_TOKEN=replace-with-the-provider-metrics-token
