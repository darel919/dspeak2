# Pinned native media dependency inputs. These values must remain explicit and
# must never be downloaded during normal Tauri application startup.
WEBRTC_BRANCH=branch-heads/7339
WEBRTC_REVISION=m140
LIBMEDIASOUPCLIENT_REPOSITORY=https://github.com/versatica/libmediasoupclient.git
LIBMEDIASOUPCLIENT_REF=webrtc-m140
LIBMEDIASOUPCLIENT_COMMIT=b9602ba50477d9a22b673fc3e6b5abff16c02deb

# Build output is intentionally outside source control.
NATIVE_MEDIA_BUILD_DIR=desktop/native-media/build

# dev:desktop provisions this ignored directory automatically on first run.
# Set an absolute path when sharing a bundle between checkouts.
NATIVE_MEDIA_ARTIFACT_DIR=desktop/native-media/bundle

# download requires a prebuilt archive and never starts a multi-gigabyte source
# checkout. Set source explicitly only on a machine with sufficient disk space.
NATIVE_MEDIA_PROVISION_MODE=download

# Normal dev runs detect the supported Tauri target or host architecture automatically.

# Optional archive overrides for local mirrors or private artifact storage.
# NATIVE_MEDIA_ARTIFACT_ARCHIVE=/absolute/path/to/lib-dspeak-media-macos-arm64.tar.gz
# NATIVE_MEDIA_ARTIFACT_URL=https://example.com/lib-dspeak-media-macos-arm64.tar.gz
# NATIVE_MEDIA_ARTIFACT_SHA256=sha256-of-the-archive

# These paths are used by the native-media source build.
# LIBWEBRTC_INCLUDE_PATH=/absolute/path/to/webrtc/include
# LIBWEBRTC_BINARY_PATH=/absolute/path/to/webrtc/lib
# LIBWEBRTC_ARTIFACT_ARCHIVE=/absolute/path/to/libwebrtc-macos-arm64.tar.gz
# LIBWEBRTC_ARTIFACT_URL=https://example.com/libwebrtc-macos-arm64.tar.gz
# LIBWEBRTC_ARTIFACT_SHA256=0e09ccab9cf35071c5731c962b0862a3000f68eda9aa3c563b2832997942cff0

# The checked-in upstream workflow uses these GN arguments for release builds.
WEBRTC_GN_ARGS=is_debug=false is_component_build=false is_clang=true rtc_include_tests=false rtc_use_h264=true treat_warnings_as_errors=false use_rtti=true
