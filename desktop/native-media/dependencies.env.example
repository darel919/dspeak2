# Pinned native media dependency inputs. These values must remain explicit and
# must never be downloaded during normal Tauri application startup.
WEBRTC_BRANCH=branch-heads/7339
WEBRTC_REVISION=m140
LIBMEDIASOUPCLIENT_REPOSITORY=https://github.com/versatica/libmediasoupclient.git
LIBMEDIASOUPCLIENT_REF=webrtc-m140
LIBMEDIASOUPCLIENT_COMMIT=b9602ba50477d9a22b673fc3e6b5abff16c02deb

# Build output is intentionally outside source control.
NATIVE_MEDIA_BUILD_DIR=desktop/native-media/build

# Absolute paths to a separately provisioned libwebrtc artifact bundle.
# LIBWEBRTC_INCLUDE_PATH=/absolute/path/to/webrtc/include
# LIBWEBRTC_BINARY_PATH=/absolute/path/to/webrtc/lib

# The checked-in upstream workflow uses these GN arguments for release builds.
WEBRTC_GN_ARGS=is_debug=false is_component_build=false is_clang=true rtc_include_tests=false rtc_use_h264=true treat_warnings_as_errors=false use_rtti=true
