{
  "$schema": "https://raw.githubusercontent.com/nice/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "dSpeak",
  "version": "3.0.0-alpha.1",
  "identifier": "com.dspeak.desktop",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd .. && DSPEAK_DESKTOP=1 npm run dev",
    "beforeBuildCommand": "node ../scripts/build-desktop-frontend.mjs && node ../scripts/build-desktop-worker.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/dspeak-media"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deepLink": {
      "schemes": [
        {
          "scheme": "tauri"
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/darel919/dspeak/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    },
    "notification": null
  }
}
